# Application
APP_NAME=AI Trip Planner API
APP_ENV=development
APP_MODE=demo
FRONTEND_ORIGIN=http://localhost:3002

# PostgreSQL (defaults match infra/docker-compose.yml)
POSTGRES_USER=trip_planner
POSTGRES_PASSWORD=trip_planner
POSTGRES_DB=trip_planner
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Canonical async SQLAlchemy database URL
DATABASE_URL=postgresql+asyncpg://trip_planner:trip_planner@localhost:5432/trip_planner

# Clerk authentication
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3002

# LLM extraction
LLM_PROVIDER=groq
GROQ_API_KEY=replace_me
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=1024

# Weather MCP tool
WEATHER_PROVIDER=open_meteo
WEATHER_REQUEST_TIMEOUT_SECONDS=5.0
WEATHER_CACHE_TTL_SECONDS=1800

# Flight search (SerpApi Google Flights for local demo)
FLIGHTS_PROVIDER=serpapi
SERPAPI_API_KEY=replace_me
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_FLIGHTS_ENGINE=google_flights
FLIGHTS_REQUEST_TIMEOUT_SECONDS=5.0
FLIGHTS_CACHE_TTL_SECONDS=300

# Amadeus (optional; used when FLIGHTS_PROVIDER=amadeus / HOTELS_PROVIDER=amadeus)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Hotel search (StayingAPI sandbox for local demo)
HOTELS_PROVIDER=stayingapi
STAYINGAPI_API_KEY=replace_me
STAYINGAPI_BASE_URL=https://api.stayingapi.com
STAYINGAPI_ENVIRONMENT=sandbox
HOTELS_REQUEST_TIMEOUT_SECONDS=5.0
HOTELS_CACHE_TTL_SECONDS=120

# OpenRouteService distance matrix (server-side only; never expose to frontend)
DISTANCE_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=replace_me
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
DISTANCE_REQUEST_TIMEOUT_SECONDS=5.0
DISTANCE_CACHE_TTL_SECONDS=600

# Places (Geoapify for local demo)
PLACES_PROVIDER=geoapify
GEOAPIFY_API_KEY=replace_me
GEOAPIFY_BASE_URL=https://api.geoapify.com
GEOAPIFY_GEOCODING_ENABLED=true
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com
PLACES_REQUEST_TIMEOUT_SECONDS=5.0
PLACES_CACHE_TTL_SECONDS=600

# Frankfurter reference exchange rates (server-side only; no API key required)
CURRENCY_PROVIDER=frankfurter
FRANKFURTER_BASE_URL=https://api.frankfurter.dev
CURRENCY_REQUEST_TIMEOUT_SECONDS=5.0
CURRENCY_CACHE_TTL_SECONDS=86400

# Parallel tool orchestration (complete-request path)
AGENT_TOOL_CONCURRENCY_LIMIT=4

# RAG destination knowledge (Gemini embeddings for local demo)
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=replace_me
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIMENSION=1536
RAG_EMBEDDING_TIMEOUT_SECONDS=30.0
RAG_CHUNK_TARGET_TOKENS=400
RAG_FRESHNESS_WARNING_DAYS=365
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
